    {
        "id": "firebase_formatter",
        "type": "function",
        "z": "f1a2b3c4d5e6",
        "name": "Format Firebase Data",
        "func": "let data = msg.payload;\nlet timestamp = new Date().getTime();\n\nlet msg_status = {\n    method: \"PATCH\",\n    url: \"https://smart-trash-iot-c0ec4-default-rtdb.asia-southeast1.firebasedatabase.app/system_status.json\",\n    headers: {\n        \"Content-Type\": \"application/json\"\n    },\n    payload: {\n        dryCount: data.dryCount,\n        wetCount: data.wetCount,\n        metalCount: data.metalCount,\n        lastUpdated: timestamp,\n        currentTrash: {\n            type: data.type,\n            moisture: data.moisture,\n            timestamp: timestamp\n        }\n    }\n};\n\nlet msg_history = {\n    method: \"POST\",\n    url: \"https://smart-trash-iot-c0ec4-default-rtdb.asia-southeast1.firebasedatabase.app/history_logs.json\",\n    headers: {\n        \"Content-Type\": \"application/json\"\n    },\n    payload: {\n        type: data.type,\n        moisture: data.moisture,\n        timestamp: timestamp\n    }\n};\n\nreturn [msg_status, msg_history];",
        "outputs": 2,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 830,
        "y": 120,
        "wires": [
            [
                "firebase_http_status"
            ],
            [
                "firebase_http_history"
            ]
        ]
