    {
        "id": "process_data",
        "type": "function",
        "z": "f1a2b3c4d5e6",
        "name": "Process Trash Data",
        "func": "let data = msg.payload;\n\nif(!data.type){\n    return null;\n}\n\nmsg.payload = {\n    type: data.type || \"none\",\n    moisture: data.moisture || 0,\n    metalCount: data.metalCount || 0,\n    wetCount: data.wetCount || 0,\n    dryCount: data.dryCount || 0\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 580,
        "y": 120,
        "wires": [
            [
                "current_detection",
                "moisture_gauge",
                "dry_card",
                "wet_card",
                "metal_card",
                "pie_function",
                "activity_chart_function",
                "activity_log",
                "toast_notification",
                "firebase_formatter"
            ]
        ]
