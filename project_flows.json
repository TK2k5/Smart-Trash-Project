    {
        "id": "format_csv",
        "type": "function",
        "z": "f1a2b3c4d5e6",
        "name": "Format CSV",
        "func": "let now = new Date().toLocaleString();\n\nlet type = msg.payload.type || \"unknown\";\nlet moisture = msg.payload.moisture || 0;\n\nlet dry = msg.payload.dryCount || 0;\nlet wet = msg.payload.wetCount || 0;\nlet metal = msg.payload.metalCount || 0;\n\nlet total = dry + wet + metal;\n\nmsg.payload =\n`${now},${type},${moisture},${dry},${wet},${metal},${total}\\n`;\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 800,
        "y": 780,
        "wires": [
